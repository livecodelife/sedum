              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "// ForPackage chooses the adopter form the package declares. A built-in adopter\n// needs no permission. A command adopter runs only when allowCommand is set.\nfunc ForPackage(pkg *genpkg.Package, allowCommand bool) (Adopter, error) {\n\tif pkg.Adopt == nil {\n\t\treturn nil, fmt.Errorf(\"package %s declares no adopter\", pkg.Name)\n\t}\n\tif name := pkg.Adopt.Builtin; name != \"\" {\n\t\tmk, ok := builtinAdopters[name]\n\t\tif !ok {\n\t\t\treturn nil, fmt.Errorf(\"package %s names the built-in adopter %q, which this sedum does not have\", pkg.Name, name)\n\t\t}\n\t\treturn mk(), nil\n\t}\n\tif len(pkg.Adopt.Command) \u003e 0 {\n\t\tline := strings.Join(pkg.Adopt.Command, \" \")\n\t\tif !allowCommand {\n\t\t\treturn nil, fmt.Errorf(\"package %s declares a command adopter (%s); rerun with --allow-command-adopters to run it\", pkg.Name, line)\n\t\t}\n\t\treturn CommandAdopter{Argv: pkg.Adopt.Command}, nil\n\t}\n\treturn NewDeclarative(pkg)\n}",
                "file": "internal/adopt/forpackage.go",
                "name": "ForPackage"
              }
            },
            {
              "action": "setVar",
              "kwargs": {
                "code": "// builtinAdopters maps the name of a built-in adopter to its constructor.\nvar builtinAdopters = map[string]func() Adopter{\"go\": func() Adopter { return GoAdopter{} }}",
                "file": "internal/adopt/forpackage.go",
                "name": "builtinAdopters"
              }
            },
            {
              "action": "addImport",
              "kwargs": {
                "file": "internal/adopt/forpackage_builtin_test.go",
                "path": "strings"
              }
            },
            {
              "action": "addImport",
              "kwargs": {
                "file": "internal/adopt/forpackage_builtin_test.go",
                "path": "testing"
              }
            },
            {
              "action": "addImport",
              "kwargs": {
                "file": "internal/adopt/forpackage_builtin_test.go",
                "path": "github.com/livecodelife/sedum/internal/genpkg"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func TestForPackageBuiltinGo(t *testing.T) {\n\tpkg := \u0026genpkg.Package{Name: \"go\", Adopt: \u0026genpkg.Adopt{Builtin: \"go\"}}\n\tad, err := ForPackage(pkg, false)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif _, ok := ad.(GoAdopter); !ok {\n\t\tt.Fatalf(\"got %T, want GoAdopter\", ad)\n\t}\n}",
                "file": "internal/adopt/forpackage_builtin_test.go",
                "name": "TestForPackageBuiltinGo"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func TestForPackageBuiltinUnknown(t *testing.T) {\n\tpkg := \u0026genpkg.Package{Name: \"cobol\", Adopt: \u0026genpkg.Adopt{Builtin: \"cobol\"}}\n\t_, err := ForPackage(pkg, false)\n\tif err == nil || !strings.Contains(err.Error(), \"does not have\") {\n\t\tt.Fatalf(\"err = %v, want it to mention \\\"does not have\\\"\", err)\n\t}\n}",
                "file": "internal/adopt/forpackage_builtin_test.go",
                "name": "TestForPackageBuiltinUnknown"
              }
            },
            {
              "action": "addImport",
              "kwargs": {
                "file": "internal/adopt/forpackage_test.go",
                "path": "reflect"
              }
            },
            {
              "action": "addImport",
