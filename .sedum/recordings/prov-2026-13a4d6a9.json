            {
              "action": "setMethod",
              "kwargs": {
                "code": "// JSON renders the summary as indented JSON with a trailing newline.\nfunc (s Summary) JSON() ([]byte, error) {\n\tb, err := json.MarshalIndent(s, \"\", \"  \")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\treturn append(b, '\\n'), nil\n}",
                "file": "internal/growlog/render.go",
                "name": "JSON",
                "receiver": "Summary"
              }
            },
            {
              "action": "setMethod",
              "kwargs": {
                "code": "// Text renders the summary as a table: one row per model and a total row. A\n// run with no model shows as (none).\nfunc (s Summary) Text() string {\n\tvar b strings.Builder\n\tfmt.Fprintf(\u0026b, \"grow log: %d line(s), %d malformed\\n\", s.Entries, s.Malformed)\n\tvar buf bytes.Buffer\n\tw := tabwriter.NewWriter(\u0026buf, 0, 8, 2, ' ', 0)\n\tfmt.Fprintln(w, \"model\\tgrows\\tfailed\\tcalls\\tretries\\trepairs\\ttokens in/out\\tliteral\")\n\trow := func(name string, m ModelStats) {\n\t\tif name == \"\" {\n\t\t\tname = \"(none)\"\n\t\t}\n\t\tfmt.Fprintf(w, \"%s\\t%d\\t%d\\t%d\\t%d\\t%d\\t%d/%d\\t%.0f%%\\n\", name, m.Grows, m.Failed, m.Calls, m.Retries, m.Repairs, m.PromptTokens, m.CompletionTokens, m.LiteralShare()*100)\n\t}\n\tfor _, m := range s.Models {\n\t\trow(m.Model, m)\n\t}\n\trow(\"total\", s.Total)\n\tw.Flush()\n\tb.Write(buf.Bytes())\n\treturn b.String()\n}",
                "file": "internal/growlog/render.go",
                "name": "Text",
                "receiver": "Summary"
              }
            },
            {
              "action": "addImport",
              "kwargs": {
                "file": "internal/growlog/render_test.go",
                "path": "strings"
              }
            },
            {
              "action": "addImport",
              "kwargs": {
                "file": "internal/growlog/render_test.go",
                "path": "testing"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func TestSummaryText(t *testing.T) {\n\ts := Summarize(summaryEntries(), Filter{})\n\ts.Malformed = 1\n\ttext := s.Text()\n\tlines := strings.Split(strings.TrimSuffix(text, \"\\n\"), \"\\n\")\n\tif lines[0] != \"grow log: 4 line(s), 1 malformed\" {\n\t\tt.Fatalf(\"first line = %q\", lines[0])\n\t}\n\tif len(lines) != 6 {\n\t\tt.Fatalf(\"got %d lines, want 6:\\n%s\", len(lines), text)\n\t}\n\twant := map[string][]string{\n\t\t\"haiku\": {\"2\", \"1\", \"5\", \"4\", \"1\", \"150/25\", \"75%\"},\n\t\t\"stub\":  {\"1\", \"0\", \"1\", \"0\", \"0\", \"0/0\", \"0%\"},\n\t\t\"total\": {\"3\", \"1\", \"6\", \"4\", \"1\", \"150/25\", \"50%\"},\n\t}\n\tfor _, l := range lines[2:] {\n\t\tf := strings.Fields(l)\n\t\tif w, ok := want[f[0]]; ok {\n\t\t\tif strings.Join(f[1:], \" \") != strings.Join(w, \" \") {\n\t\t\t\tt.Errorf(\"row %s = %v, want %v\", f[0], f[1:], w)\n\t\t\t}\n\t\t\tdelete(want, f[0])\n\t\t}\n\t}\n\tif len(want) != 0 {\n\t\tt.Errorf(\"rows missing: %v\\n%s\", want, text)\n\t}\n\tif !strings.Contains(text, \"(none)\") {\n\t\tt.Errorf(\"a run with no model must show as (none):\\n%s\", text)\n\t}\n}",
                "file": "internal/growlog/render_test.go",
                "name": "TestSummaryText"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func TestSummaryJSON(t *testing.T) {\n\tb, err := Summarize(nil, Filter{}).JSON()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\ts := string(b)\n\tif !strings.HasSuffix(s, \"\\n\") || !strings.Contains(s, `\"models\": []`) {\n\t\tt.Fatalf(\"JSON = %q\", s)\n\t}\n\tif strings.Contains(s, \"timestamp\") {\n\t\tt.Fatalf(\"a summary carries no timestamp: %q\", s)\n\t}\n}",
                "file": "internal/growlog/render_test.go",
                "name": "TestSummaryJSON"
              }
            }
          ]
        }
