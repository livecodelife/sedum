              }
            },
            {
              "action": "addImport",
              "kwargs": {
                "file": "internal/growlog/read_test.go",
                "path": "testing"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func TestReadSkipsMalformedLines(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"grow.jsonl\")\n\tdata := \"{\\\"v\\\":1,\\\"record\\\":\\\"a\\\"}\\n\\nnot json\\n{\\\"v\\\":1,\\\"record\\\":\\\"b\\\"}\\n\"\n\tif err := os.WriteFile(path, []byte(data), 0o644); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tentries, malformed, err := Read(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(entries) != 2 || malformed != 1 {\n\t\tt.Fatalf(\"entries = %d, malformed = %d, want 2 and 1\", len(entries), malformed)\n\t}\n\tif entries[0].Record != \"a\" || entries[1].Record != \"b\" {\n\t\tt.Fatalf(\"entries out of order: %+v\", entries)\n\t}\n}",
                "file": "internal/growlog/read_test.go",
                "name": "TestReadSkipsMalformedLines"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func TestReadMissingFile(t *testing.T) {\n\tif _, _, err := Read(filepath.Join(t.TempDir(), \"none.jsonl\")); err == nil {\n\t\tt.Fatal(\"want an error for a missing file\")\n\t}\n}",
                "file": "internal/growlog/read_test.go",
                "name": "TestReadMissingFile"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func TestAppendConcurrent(t *testing.T) {\n\tpath := filepath.Join(t.TempDir(), \"grow.jsonl\")\n\tvar wg sync.WaitGroup\n\tfor i := 0; i \u003c 20; i++ {\n\t\twg.Add(1)\n\t\tgo func() {\n\t\t\tdefer wg.Done()\n\t\t\tif err := Append(path, Entry{Record: \"r\", Model: \"m\", Outcome: \"ok\"}); err != nil {\n\t\t\t\tt.Error(err)\n\t\t\t}\n\t\t}()\n\t}\n\twg.Wait()\n\tentries, malformed, err := Read(path)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(entries) != 20 || malformed != 0 {\n\t\tt.Fatalf(\"entries = %d, malformed = %d, want 20 and 0\", len(entries), malformed)\n\t}\n}",
                "file": "internal/growlog/read_test.go",
                "name": "TestAppendConcurrent"
              }
            }
          ]
        }
