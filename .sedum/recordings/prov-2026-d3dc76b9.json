            {
              "action": "setType",
              "kwargs": {
                "code": "// VerifyError is the error for a record whose selection still failed the\n// project's verification after every repair it was allowed. It carries what the\n// record's calls cost, so a caller that records cost does not lose it.\ntype VerifyError struct {\n\tRecordID         string\n\tRepairs          int\n\tCalls            int\n\tRejected         int\n\tCompleteness     int\n\tPromptTokens     int\n\tCompletionTokens int\n\tFailure          string\n}",
                "file": "internal/selection/verifyerror.go",
                "name": "VerifyError"
              }
            },
            {
              "action": "setMethod",
              "kwargs": {
                "code": "// Error describes the failure with the repairs, calls and rejections spent.\nfunc (e *VerifyError) Error() string {\n\treturn fmt.Sprintf(\"record %s: the selection did not verify after %d repair attempt(s) (%d model call(s), %d answer(s) rejected by validation):\\n%s\",\n\t\te.RecordID, e.Repairs, e.Calls, e.Rejected, e.Failure)\n}",
                "file": "internal/selection/verifyerror.go",
                "name": "Error",
                "receiver": "VerifyError"
              }
            },
            {
              "action": "addImport",
              "kwargs": {
                "file": "internal/selection/verifyerror_test.go",
                "path": "errors"
              }
            },
            {
              "action": "addImport",
              "kwargs": {
                "file": "internal/selection/verifyerror_test.go",
                "path": "fmt"
              }
            },
            {
              "action": "addImport",
              "kwargs": {
                "file": "internal/selection/verifyerror_test.go",
                "path": "strings"
              }
            },
            {
              "action": "addImport",
              "kwargs": {
                "file": "internal/selection/verifyerror_test.go",
                "path": "testing"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func TestVerifyErrorMessage(t *testing.T) {\n\terr := \u0026VerifyError{RecordID: \"r1\", Repairs: 2, Calls: 3, Rejected: 1, Failure: \"tsc failed\"}\n\twant := \"record r1: the selection did not verify after 2 repair attempt(s) (3 model call(s), 1 answer(s) rejected by validation):\\ntsc failed\"\n\tif got := err.Error(); got != want {\n\t\tt.Fatalf(\"Error() = %q, want %q\", got, want)\n\t}\n}",
                "file": "internal/selection/verifyerror_test.go",
                "name": "TestVerifyErrorMessage"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func TestVerifyErrorIsFoundThroughWrapping(t *testing.T) {\n\tvar err error = fmt.Errorf(\"grow: %w\", \u0026VerifyError{RecordID: \"r2\", PromptTokens: 10, CompletionTokens: 4})\n\tvar ve *VerifyError\n\tif !errors.As(err, \u0026ve) || ve.RecordID != \"r2\" || ve.PromptTokens != 10 || ve.CompletionTokens != 4 {\n\t\tt.Fatalf(\"errors.As found %+v\", ve)\n\t}\n\tif !strings.Contains(err.Error(), \"r2\") {\n\t\tt.Fatalf(\"message lost the record: %v\", err)\n\t}\n}",
                "file": "internal/selection/verifyerror_test.go",
                "name": "TestVerifyErrorIsFoundThroughWrapping"
              }
            }
          ]
        }
