            {
              "action": "setFunction",
              "kwargs": {
                "code": "// HaikuGrow returns a Grow that runs sedum through the herd's sedum-haiku\n// wrapper, which pins claude-haiku-5-5. The harness passes no model flag, and\n// the wrapper refuses one: no other model is allowed.\nfunc HaikuGrow(wrapper, sedumBin string) func(ctx context.Context, dir string) error {\n\treturn func(ctx context.Context, dir string) error {\n\t\tcmd := exec.CommandContext(ctx, wrapper, \"grow\",\n\t\t\t\"--generators\", \"./generators\", \"--records\", \"./provenance\",\n\t\t\t\"--prompt-file\", \"PROMPT.md\", \"--verify\", \"go vet ./...\")\n\t\tcmd.Dir = dir\n\t\tcmd.Env = append(os.Environ(), \"SEDUM_BIN=\"+sedumBin)\n\t\tout, err := cmd.CombinedOutput()\n\t\tif err != nil {\n\t\t\tlines := strings.Split(strings.TrimSpace(string(out)), \"\\n\")\n\t\t\treturn fmt.Errorf(\"%s\", lines[len(lines)-1])\n\t\t}\n\t\treturn nil\n\t}\n}",
                "file": "evals/design/haiku_eval.go",
                "name": "HaikuGrow"
              }
            },
            {
              "action": "addImport",
              "kwargs": {
                "file": "evals/design/haiku_eval_test.go",
                "path": "context"
              }
            },
            {
              "action": "addImport",
              "kwargs": {
                "file": "evals/design/haiku_eval_test.go",
                "path": "os"
              }
            },
            {
              "action": "addImport",
              "kwargs": {
                "file": "evals/design/haiku_eval_test.go",
                "path": "path/filepath"
              }
            },
            {
              "action": "addImport",
              "kwargs": {
                "file": "evals/design/haiku_eval_test.go",
                "path": "strings"
              }
            },
            {
              "action": "addImport",
              "kwargs": {
                "file": "evals/design/haiku_eval_test.go",
                "path": "testing"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "// fakeWrapper writes an executable shell script and returns its path.\nfunc fakeWrapper(t *testing.T, dir, body string) string {\n\tt.Helper()\n\tpath := filepath.Join(dir, \"wrapper.sh\")\n\tif err := os.WriteFile(path, []byte(\"#!/bin/sh\\n\"+body), 0o755); err != nil {\n\t\tt.Fatal(err)\n\t}\n\treturn path\n}",
                "file": "evals/design/haiku_eval_test.go",
                "name": "fakeWrapper"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func TestHaikuGrowRunsTheWrapperWithoutAModelFlag(t *testing.T) {\n\tdir := t.TempDir()\n\targs := filepath.Join(dir, \"args\")\n\twrapper := fakeWrapper(t, dir, \"echo \\\"$@\\\" \u003e \"+args+\"\\necho \\\"SEDUM_BIN=$SEDUM_BIN\\\" \u003e\u003e \"+args+\"\\n\")\n\tif err := HaikuGrow(wrapper, \"/bin/sedum-x\")(context.Background(), dir); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdata, err := os.ReadFile(args)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tgot := string(data)\n\tfor _, want := range []string{\"grow --generators ./generators --records ./provenance --prompt-file PROMPT.md --verify go vet ./...\", \"SEDUM_BIN=/bin/sedum-x\"} {\n\t\tif !strings.Contains(got, want) {\n\t\t\tt.Errorf(\"wrapper arguments lack %q:\\n%s\", want, got)\n\t\t}\n\t}\n\tif strings.Contains(got, \"--model\") {\n\t\tt.Errorf(\"no model flag may be passed:\\n%s\", got)\n\t}\n}",
                "file": "evals/design/haiku_eval_test.go",
                "name": "TestHaikuGrowRunsTheWrapperWithoutAModelFlag"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func TestHaikuGrowReportsTheLastOutputLine(t *testing.T) {\n\tdir := t.TempDir()\n\twrapper := fakeWrapper(t, dir, \"echo first\\necho boom\\nexit 1\\n\")\n\terr := HaikuGrow(wrapper, \"/bin/sedum-x\")(context.Background(), dir)\n\tif err == nil || err.Error() != \"boom\" {\n\t\tt.Fatalf(\"err = %v, want boom\", err)\n\t}\n}",
                "file": "evals/design/haiku_eval_test.go",
                "name": "TestHaikuGrowReportsTheLastOutputLine"
              }
            }
          ]
        }
