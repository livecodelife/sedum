            "name": "TestGeneratorsDrift"
          },
          "kwargs": {
            "code": "func TestGeneratorsDrift(t *testing.T) {\n\troot := filepath.Join(\"..\", \"..\", \"generators\", \"go\")\n\tif _, err := os.Stat(root); os.IsNotExist(err) {\n\t\tt.Skip(\"generators/go does not exist\")\n\t}\n\tfiles, err := Files(\"go\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsrc := make(map[string][]byte)\n\terr = filepath.WalkDir(root, func(p string, d os.DirEntry, err error) error {\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif d.IsDir() {\n\t\t\treturn nil\n\t\t}\n\t\trel, err := filepath.Rel(root, p)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tdata, err := os.ReadFile(p)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tsrc[filepath.ToSlash(rel)] = data\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor k, want := range src {\n\t\tgot, ok := files[k]\n\t\tif !ok || !bytes.Equal(got, want) {\n\t\t\tt.Errorf(\"generators/go/%s differs from built-in package; run hack/sync-builtin.sh\", k)\n\t\t}\n\t}\n\tfor k := range files {\n\t\tif _, ok := src[k]; !ok {\n\t\t\tt.Errorf(\"built-in package has %s missing from generators/go; run hack/sync-builtin.sh\", k)\n\t\t}\n\t}\n}",
            "file": "internal/builtin/builtin_test.go",
            "name": "TestGeneratorsDrift"
          },
          "kwargs_hash": "sha256:9df199d3ab110e2512a6f11672a5d2feed9851279b615d7a30bea164a40f8840",
          "body": "sha256:d13112a4ce2ee91f44042e0416a784e0c7e4bd7cc80873f11f14bb4550dc4453"
        },
