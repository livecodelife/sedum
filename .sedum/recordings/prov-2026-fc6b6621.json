            {
              "action": "setFunction",
              "kwargs": {
                "code": "// Names returns the sorted names of the built-in packages.\nfunc Names() []string {\n\tentries, err := packagesFS.ReadDir(\"packages\")\n\tif err != nil {\n\t\treturn nil\n\t}\n\tvar names []string\n\tfor _, e := range entries {\n\t\tname := e.Name()\n\t\tif strings.HasSuffix(name, \".zip\") {\n\t\t\tnames = append(names, strings.TrimSuffix(name, \".zip\"))\n\t\t}\n\t}\n\tsort.Strings(names)\n\treturn names\n}",
                "file": "internal/builtin/builtin.go",
                "name": "Names"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "// Files returns every file of the named built-in package, keyed by its\n// slash-separated path relative to the package root.\nfunc Files(name string) (map[string][]byte, error) {\n\tknown := Names()\n\tfound := false\n\tfor _, n := range known {\n\t\tif n == name {\n\t\t\tfound = true\n\t\t\tbreak\n\t\t}\n\t}\n\tif !found {\n\t\treturn nil, fmt.Errorf(\"no built-in package %q; built-in packages: %s\", name, strings.Join(known, \", \"))\n\t}\n\tdata, err := packagesFS.ReadFile(\"packages/\" + name + \".zip\")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tzr, err := zip.NewReader(bytes.NewReader(data), int64(len(data)))\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tfiles := make(map[string][]byte)\n\tfor _, f := range zr.File {\n\t\tif strings.HasPrefix(f.Name, \"/\") || strings.Contains(f.Name, \"..\") || strings.HasSuffix(f.Name, \"/\") {\n\t\t\treturn nil, fmt.Errorf(\"invalid path %q in built-in package %q\", f.Name, name)\n\t\t}\n\t\trc, err := f.Open()\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tcontent, err := io.ReadAll(rc)\n\t\trc.Close()\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tfiles[f.Name] = content\n\t}\n\treturn files, nil\n}",
                "file": "internal/builtin/builtin.go",
                "name": "Files"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "// Paths returns the keys of files sorted.\nfunc Paths(files map[string][]byte) []string {\n\tpaths := make([]string, 0, len(files))\n\tfor p := range files {\n\t\tpaths = append(paths, p)\n\t}\n\tsort.Strings(paths)\n\treturn paths\n}",
                "file": "internal/builtin/builtin.go",
                "name": "Paths"
              }
            },
