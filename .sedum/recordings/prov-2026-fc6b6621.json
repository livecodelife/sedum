            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func TestNames(t *testing.T) {\n\tgot := Names()\n\tif len(got) != 1 || got[0] != \"go\" {\n\t\tt.Fatalf(\"Names() = %q, want [go]\", got)\n\t}\n}",
                "file": "internal/builtin/builtin_test.go",
                "name": "TestNames"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func TestFilesGo(t *testing.T) {\n\tfiles, err := Files(\"go\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor _, want := range []string{\"sedum.yaml\", \"actions/actions.yaml\"} {\n\t\tif _, ok := files[want]; !ok {\n\t\t\tt.Errorf(\"Files(\\\"go\\\") missing %s\", want)\n\t\t}\n\t}\n\tfor k := range files {\n\t\tif strings.HasPrefix(k, \"/\") || strings.Contains(k, \"..\") {\n\t\t\tt.Errorf(\"Files(\\\"go\\\") returned unsafe path %q\", k)\n\t\t}\n\t}\n}",
                "file": "internal/builtin/builtin_test.go",
                "name": "TestFilesGo"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func TestFilesUnknown(t *testing.T) {\n\t_, err := Files(\"x\")\n\tif err == nil {\n\t\tt.Fatal(\"Files(\\\"x\\\") returned no error\")\n\t}\n\tif !strings.Contains(err.Error(), \"go\") {\n\t\tt.Errorf(\"error %q does not name the built-in package go\", err)\n\t}\n}",
                "file": "internal/builtin/builtin_test.go",
                "name": "TestFilesUnknown"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func TestPathsSorted(t *testing.T) {\n\tgot := Paths(map[string][]byte{\"b\": nil, \"a\": nil, \"c/d\": nil})\n\tif !sort.StringsAreSorted(got) {\n\t\tt.Errorf(\"Paths() = %q, not sorted\", got)\n\t}\n\twant := []string{\"a\", \"b\", \"c/d\"}\n\tif len(got) != len(want) {\n\t\tt.Fatalf(\"Paths() = %q, want %q\", got, want)\n\t}\n\tfor i := range want {\n\t\tif got[i] != want[i] {\n\t\t\tt.Fatalf(\"Paths() = %q, want %q\", got, want)\n\t\t}\n\t}\n}",
                "file": "internal/builtin/builtin_test.go",
                "name": "TestPathsSorted"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func TestGeneratorsDrift(t *testing.T) {\n\troot := filepath.Join(\"..\", \"..\", \"generators\", \"go\")\n\tif _, err := os.Stat(root); os.IsNotExist(err) {\n\t\tt.Skip(\"generators/go does not exist\")\n\t}\n\tfiles, err := Files(\"go\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsrc := make(map[string][]byte)\n\terr = filepath.WalkDir(root, func(p string, d os.DirEntry, err error) error {\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tif d.IsDir() {\n\t\t\treturn nil\n\t\t}\n\t\trel, err := filepath.Rel(root, p)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tdata, err := os.ReadFile(p)\n\t\tif err != nil {\n\t\t\treturn err\n\t\t}\n\t\tsrc[filepath.ToSlash(rel)] = data\n\t\treturn nil\n\t})\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfor k, want := range src {\n\t\tgot, ok := files[k]\n\t\tif !ok || !bytes.Equal(got, want) {\n\t\t\tt.Errorf(\"generators/go/%s differs from built-in package; run hack/sync-builtin.sh\", k)\n\t\t}\n\t}\n\tfor k := range files {\n\t\tif _, ok := src[k]; !ok {\n\t\t\tt.Errorf(\"built-in package has %s missing from generators/go; run hack/sync-builtin.sh\", k)\n\t\t}\n\t}\n}",
                "file": "internal/builtin/builtin_test.go",
                "name": "TestGeneratorsDrift"
              }
            }
          ]
        }
