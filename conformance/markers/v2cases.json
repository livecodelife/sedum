        "record": "PR-014",
        "gen": "",
        "pkg": "",
        "writer": "sedum",
        "kwargs": {
          "controller": "users",
          "name": "index"
        },
        "extra": {},
        "version": 2,
        "kwargs_hash": "sha256:7049c5d3e00c4b3073ce24d20d2fe00746f7070c7b2ae6036e297ff5c347fa51",
        "body": "sha256:9516a9ba61403ce27a2a2c3574d1a1feb9ed8250374990aca2631d882b031a64",
        "foreign": false
      },
      "output": "# sedum:createControllerMethod:index {\"v\":2,\"tier\":\"owned\",\"record\":\"PR-014\",\"id\":{\"controller\":\"users\",\"name\":\"index\"},\"kwargs\":\"sha256:7049c5d3e00c4b3073ce24d20d2fe00746f7070c7b2ae6036e297ff5c347fa51\",\"body\":\"sha256:9516a9ba61403ce27a2a2c3574d1a1feb9ed8250374990aca2631d882b031a64\",\"harness_attempts\":2}"
    }
