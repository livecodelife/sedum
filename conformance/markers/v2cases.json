            "a": 1
          },
          "kwargs": "sha256:7049c5d3e00c4b3073ce24d20d2fe00746f7070c7b2ae6036e297ff5c347fa51",
          "body": "sha256:9516a9ba61403ce27a2a2c3574d1a1feb9ed8250374990aca2631d882b031a64"
        },
        "version": 0,
        "kwargs_hash": "",
        "body": "",
        "foreign": true,
        "recognized": true
      }
    },
    {
      "id": "error/v2-kwargs-is-an-object",
      "kind": "error",
      "why": "In a v2 marker kwargs is a hash string. An object there is a v1 marker mislabeled or a corrupt one, and reading it silently would hide that.",
      "comment_prefix": "#",
      "input": "# sedum:addStep:run {\"v\":2,\"tier\":\"owned\",\"kwargs\":{\"a\":1}}",
      "error": true,
      "error_names": "kwargs must be a string"
    },
    {
      "id": "error/v1-kwargs-is-a-string",
      "kind": "error",
      "why": "In a v1 marker kwargs is an object. A string there is a v2 field on a marker with no v, and treating it as a hash would read a marker no writer produced.",
      "comment_prefix": "#",
      "input": "# sedum:addStep:run {\"tier\":\"owned\",\"kwargs\":\"sha256:7049c5d3e00c4b3073ce24d20d2fe00746f7070c7b2ae6036e297ff5c347fa51\"}",
      "error": true,
      "error_names": "kwargs must be an object"
    },
    {
      "id": "replace/v1-with-unknown-key-becomes-v2",
      "kind": "replace",
      "why": "Replacing a v1 marker writes a v2 one: every modelled field comes from the marker being written and the unmodelled keys from the one being replaced. The unknown key survives, and the v1 kwargs object is gone, not written beside the hash.",
      "comment_prefix": "#",
      "existing": "# sedum:createControllerMethod:index {\"tier\":\"owned\",\"record\":\"PR-014\",\"kwargs\":{\"collection\":\"users\",\"controller\":\"users\",\"name\":\"index\"},\"harness_attempts\":2}",
      "marker": {
