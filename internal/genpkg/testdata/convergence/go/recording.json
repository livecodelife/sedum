            {
              "action": "setVar",
              "kwargs": {
                "code": "var handlers = map[string]func(s *Server, c *Client, m Message){}",
                "file": "running.go",
                "name": "handlers"
              }
            },
            {
              "action": "setFunction",
              "kwargs": {
                "code": "func main() {\n\taddr := flag.String(\"addr\", \":6667\", \"listen address\")\n\tflag.Parse()\n\ts := &Server{clients: map[string]*Client{}, channels: map[string]*channel{}}\n\tln, err := net.Listen(\"tcp\", *addr)\n\tif err != nil {\n\t\tlog.Fatal(err)\n\t}\n\tfor {\n\t\tconn, err := ln.Accept()\n\t\tif err != nil {\n\t\t\tlog.Fatal(err)\n\t\t}\n\t\tgo s.serve(conn)\n\t}\n}",
                "file": "running.go",
                "name": "main"
              }
            },
            {
              "action": "setMethod",
              "kwargs": {
                "code": "// serve runs one connection: it sets c.conn, reads CRLF or bare-LF lines, dispatches through handlers, and calls Disconnect when the connection ends.\n// serve is rendered by graft; its body is a convergence region (runningServeBody).\nfunc (s *Server) serve(conn net.Conn) {\n\ts.runningServeBody(conn)\n}",
                "file": "running.go",
                "name": "serve",
                "receiver": "Server"
              }
            },
            {
              "action": "setMethod",
              "kwargs": {
                "code": "// Send queues one protocol line for c. line carries no trailing CRLF and is already complete, including any leading ':'; Send only appends CRLF.\n// Send is rendered by graft; its body is a convergence region (runningSendBody).\nfunc (c *Client) Send(line string) {\n\tc.runningSendBody(line)\n}",
                "file": "running.go",
                "name": "Send",
                "receiver": "Client"
              }
            },
            {
              "action": "setMethod",
              "kwargs": {
                "code": "// Reply sends c a line from the server itself, built in full: \":\" + serverName + \" \" + code + \" \" + target + \" :\" + text, where target is c.Nick, or \"*\" before c has a nick.\n// Reply is rendered by graft; its body is a convergence region (runningReplyBody).\nfunc (s *Server) Reply(c *Client, code string, text string) {\n\ts.runningReplyBody(c, code, text)\n}",
                "file": "running.go",
                "name": "Reply",
                "receiver": "Server"
              }
            },
            {
              "action": "setMethod",
              "kwargs": {
                "code": "// Prefix returns c's prefix, nick!user@freeq-lite, WITHOUT the leading ':'. Every sender of a prefixed line adds the ':' itself (\":\" + c.Prefix() + \" JOIN ...\"), including QUIT.\n// Prefix is rendered by graft; its body is a convergence region (runningPrefixBody).\nfunc (c *Client) Prefix() string {\n\treturn c.runningPrefixBody()\n}",
                "file": "running.go",
                "name": "Prefix",
                "receiver": "Client"
              }
            },
            {
              "action": "setMethod",
              "kwargs": {
                "code": "// Disconnect removes c from the server and from every channel, tells the channel peers \":\" + c.Prefix() + \" QUIT :\" + reason (once each), then closes c.conn.\n// Disconnect is rendered by graft; its body is a convergence region (runningDisconnectBody).\nfunc (s *Server) Disconnect(c *Client, reason string) {\n\ts.runningDisconnectBody(c, reason)\n}",
                "file": "running.go",
                "name": "Disconnect",
                "receiver": "Server"
              }
            }
